<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TextToSpeech SDK 필수 권한 (공식 문서) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- NaviHelper 조회 API(getTBTInfo, getDestinationInfo 등) 권한. SDK 소스에서 확인 (Protection level: Normal) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 외부 에이전트(웹훅) 호출 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- usesCleartextTraffic: 에뮬레이터에서 PC의 모의 에이전트(http://10.0.2.2:8080)를 부르기 위한 실험용 설정.
         제출용 빌드에서는 끄고 HTTPS만 쓴다. -->
    <application
        android:label="BYOA 구동 실험"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- AAOS에서 주행 중 화면을 띄우려면 주행 중 사용 가능 표시가 필요하다.
                 이 앱은 주행 중에는 최소 화면만 보여준다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 시나리오 시연 화면 (adb shell am start -n ai.byoa.probe/.ScenarioActivity) -->
        <activity
            android:name=".ScenarioActivity"
            android:exported="true">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
